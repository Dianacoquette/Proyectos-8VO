name: dockercompose1796863940906388205
services:
  sensores.api:
    build:
      context: C:\Users\cesar\OneDrive\Desktop\Sensores-Services Die\Sensores-Services\src\Sensores-Services
      dockerfile: Services/Catalog/Sensores.Api/Dockerfile
    container_name: sensoresapi
    depends_on:
      sensoresdb:
        condition: service_started
        required: true
    environment:
      ASPNETCORE_ENVIRONMENT: Development
      ConnectionStrings__SensoresDb: Host=sensoresdb;Port=5432;Database=SensoresDb;Username=postgres;Password=postgres
      HOST_IP: 10.84.147.137
    networks:
      default: null
    ports:
      - mode: ingress
        target: 8080
        published: "8081"
        protocol: tcp
  sensoresdb:
    container_name: sensoresdb
    environment:
      POSTGRES_DB: SensoresDb
      POSTGRES_PASSWORD: postgres
      POSTGRES_USER: postgres
    image: postgres:15
    networks:
      default: null
    ports:
      - mode: ingress
        target: 5432
        published: "5434"
        protocol: tcp
    restart: always
    volumes:
      - type: volume
        source: postgres_sensores
        target: /var/lib/postgresql/data
        volume: {}
networks:
  default:
    name: dockercompose1796863940906388205_default
volumes:
  postgres_sensores:
    name: dockercompose1796863940906388205_postgres_sensores