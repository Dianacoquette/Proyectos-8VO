name: dockercompose5547764845092293121
services:
  sensores.api:
    build:
      context: C:\Proyectos\9NO\Microservices Net core\Sensores-Services Die\Sensores-Services\src\Sensores-Services
      dockerfile: Services/Catalog/Sensores.Api/Dockerfile
      args:
        BUILD_CONFIGURATION: Debug
        LAUNCHING_FROM_VS: "true"
      labels:
        com.microsoft.created-by: visual-studio
        com.microsoft.visual-studio.project-name: Sensores.Api
      target: base
    container_name: sensoresapi
    depends_on:
      sensoresdb:
        condition: service_started
        required: true
    entrypoint:
      - dotnet
      - --roll-forward
      - Major
      - /VSTools/DistrolessHelper/DistrolessHelper.dll
      - --wait
    environment:
      ASPNETCORE_ENVIRONMENT: Development
      ASPNETCORE_LOGGING__CONSOLE__DISABLECOLORS: "true"
      ConnectionStrings__SensoresDb: Host=sensoresdb;Port=5432;Database=SensoresDb;Username=postgres;Password=postgres
      DOTNET_USE_POLLING_FILE_WATCHER: "1"
      HOST_IP: 10.84.147.137
      NUGET_FALLBACK_PACKAGES: /.nuget/fallbackpackages
    image: sensoresapi:dev
    labels:
      com.microsoft.visualstudio.debuggee.arguments: ' --additionalProbingPath /.nuget/packages --additionalProbingPath /.nuget/fallbackpackages  "/app/bin/Debug/net9.0/Sensores.Api.dll"'
      com.microsoft.visualstudio.debuggee.killprogram: dotnet --roll-forward Major /VSTools/DistrolessHelper/DistrolessHelper.dll --stop dotnet
      com.microsoft.visualstudio.debuggee.program: dotnet
      com.microsoft.visualstudio.debuggee.workingdirectory: /app
    networks:
      default: null
    ports:
      - mode: ingress
        target: 8080
        published: "8081"
        protocol: tcp
    tty: true
    volumes:
      - type: bind
        source: C:\Users\cesar\OneDrive\Desktop\Sensores-Services Die\Sensores-Services\src\Sensores-Services\Services\Catalog\Sensores.Api
        target: /app
        bind: {}
      - type: bind
        source: C:\Users\cesar\OneDrive\Desktop\Sensores-Services Die\Sensores-Services\src\Sensores-Services
        target: /src
        bind: {}
      - type: bind
        source: C:\Users\cesar\vsdbg\vs2017u5
        target: /remote_debugger
        bind: {}
      - type: bind
        source: C:\Users\cesar\.nuget\packages
        target: /.nuget/packages
        read_only: true
        bind: {}
      - type: bind
        source: C:\Program Files (x86)\Microsoft Visual Studio\Shared\NuGetPackages
        target: /.nuget/fallbackpackages
        read_only: true
        bind: {}
      - type: bind
        source: C:\Users\cesar\AppData\Roaming\ASP.NET\Https
        target: /root/.aspnet/https
        read_only: true
        bind: {}
      - type: bind
        source: C:\Users\cesar\AppData\Roaming\ASP.NET\Https
        target: /home/app/.aspnet/https
        read_only: true
        bind: {}
      - type: bind
        source: C:\Users\cesar\AppData\Roaming\Microsoft\UserSecrets
        target: /root/.microsoft/usersecrets
        read_only: true
        bind: {}
      - type: bind
        source: C:\Users\cesar\AppData\Roaming\Microsoft\UserSecrets
        target: /home/app/.microsoft/usersecrets
        read_only: true
        bind: {}
      - type: bind
        source: C:\Program Files\Microsoft Visual Studio\18\Community\MSBuild\Sdks\Microsoft.Docker.Sdk\tools\linux-x64\net6.0
        target: /VSTools
        read_only: true
        bind: {}
      - type: bind
        source: C:\Program Files\Microsoft Visual Studio\18\Community\Common7\IDE\extensions\Microsoft\managedprojectsystem\HotReload
        target: /HotReloadAgent
        read_only: true
        bind: {}
  sensoresdb:
    container_name: sensoresdb
    environment:
      POSTGRES_DB: SensoresDb
      POSTGRES_PASSWORD: postgres
      POSTGRES_USER: postgres
    image: postgres:15
    networks:
      default: null
    ports:
      - mode: ingress
        target: 5432
        published: "5434"
        protocol: tcp
    restart: always
    volumes:
      - type: volume
        source: postgres_sensores
        target: /var/lib/postgresql/data
        volume: {}
networks:
  default:
    name: dockercompose5547764845092293121_default
volumes:
  postgres_sensores:
    name: dockercompose5547764845092293121_postgres_sensores