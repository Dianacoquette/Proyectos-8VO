name: dockercompose9693101361564240090
services:
  sensores.api:
    build:
      context: C:\Proyectos\9NO\Microservices Net core\Sensores-Services2-con-kafka\src\Sensores-Services
      dockerfile: Services/Catalog/Sensores.Api/Dockerfile
    container_name: sensoresapi
    depends_on:
      sensoresdb:
        condition: service_started
        required: true
    environment:
      ASPNETCORE_ENVIRONMENT: Development
      ConnectionStrings__SensoresDb: Host=sensoresdb;Port=5432;Database=SensoresDb;Username=postgres;Password=postgres
      HOST_IP: 10.84.147.137
      Kafka__BootstrapServers: host.docker.internal:9092
      Kafka__GroupId: sensores-api-group
      Kafka__Topic: lecturas-sensores
    networks:
      default: null
    ports:
      - mode: ingress
        target: 8080
        published: "8081"
        protocol: tcp
  sensoresdb:
    container_name: sensoresdb
    environment:
      POSTGRES_DB: SensoresDb
      POSTGRES_PASSWORD: postgres
      POSTGRES_USER: postgres
    image: postgres:15
    networks:
      default: null
    ports:
      - mode: ingress
        target: 5432
        published: "5434"
        protocol: tcp
    restart: always
    volumes:
      - type: volume
        source: postgres_sensores
        target: /var/lib/postgresql/data
        volume: {}
networks:
  default:
    name: dockercompose9693101361564240090_default
volumes:
  postgres_sensores:
    name: dockercompose9693101361564240090_postgres_sensores